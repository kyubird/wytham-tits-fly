.groups = 'drop'
) %>%
mutate(
sd_lower = mean_v1 - sd_v1,
sd_upper = mean_v1 + sd_v1
)
# Plot
v1_var_graph <- ggplot(nat.var, aes(x = Ring, y = v1, color = species)) +
geom_jitter(width = 0.2, alpha = 0.5) +  # individual v1 dots
geom_point(data = summary_df, aes(x=Ring, y = mean_v1, color ="grey"), size = 2, shape = 16, inherit.aes = FALSE) +  # mean points
geom_errorbar(data = summary_df, aes(x=Ring, ymin = sd_lower, ymax = sd_upper, color = "grey"), width = 0.2, inherit.aes = FALSE) +  # ±1 SD
# Species-level overlaying in black
geom_point(data = species_summary, aes(x = Inf-0.5, y = mean_v1), color = "black", size = 4, shape = 18, inherit.aes = FALSE) +
geom_errorbar(data = species_summary, aes(x = Inf-0.5, ymin = sd_lower, ymax = sd_upper), color = "black", width = 0.4, inherit.aes = FALSE) +
facet_wrap(~ species, scales = "free_x", labeller = labeller(
species = c(
"bluti" = "Blue Tit",
"greti" = "Great Tit",
"marti" = "Marsh Tit" ))) +  # group by species
theme_minimal() +
labs(
x ="",
y = expression("Initial Velocity ("*m/s*")"),
) +
theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
theme(
axis.text.x = element_blank(),     # hides x-axis labels
axis.ticks.x = element_blank(),    # hides x-axis ticks
legend.position = "none"
)
